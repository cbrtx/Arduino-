// Определение пинов
const uint8_t ledG = 3;  // Зеленый канал RGB светодиода (PWM пин)
const uint8_t ledB = 5;  // Синий канал RGB светодиода (PWM пин)  
const uint8_t ledR = 6;  // Красный канал RGB светодиода (PWM пин)
#define trigPin 10       // Trig пин датчика (выход - инициирование измерения)
#define echoPin 9        // Echo пин датчика (вход - получение ответного сигнала)
#define Buzzer 8         // Пин подключения зуммера/пищалки

void setup()
{
  // Настройка режимов работы пинов
  pinMode(ledG, OUTPUT);   // Зеленый канал RGB как выход
  pinMode(ledB, OUTPUT);   // Синий канал RGB как выход
  pinMode(ledR, OUTPUT);   // Красный канал RGB как выход
  pinMode(Buzzer, OUTPUT); // Зуммер как выход
  pinMode(trigPin, OUTPUT); // Trig пин как выход (Arduino → датчик)
  pinMode(echoPin, INPUT);  // Echo пин как вход (датчик → Arduino)
  // Инициализация последовательного порта для отладки и мониторинга
  Serial.begin(9600);      
}

void loop()
{
  // Объявление переменных для измерений
  long durationindigit, distanceincm; // durationindigit - длительность импульса в микросекундах
                                      // distanceincm - расстояние в сантиметрах
  // Формирование ультразвукового импульса
  digitalWrite(trigPin, LOW);        // Гарантированно низкий уровень
  delay(2);                          // Короткая пауза 2 мс
  digitalWrite(trigPin, HIGH);       // Поднимаем сигнал HIGH
  delay(10);                         // Держим 10 микросекунд (импульс запуска)
  digitalWrite(trigPin, LOW);        // Опускаем сигнал LOW
  
  // Измерение длительности ответного импульса
  durationindigit = pulseIn(echoPin, HIGH); // Измеряем время высокого уровня на Echo пине
                                            // (время от отправки до получения эха)
  
  // Расчет расстояния по времени прохождения звука
  distanceincm = (durationindigit * 0.034) / 2; // 0.034 см/μs - скорость звука
                                                // делим на 2, потому что звук идет туда и обратно
  
  // Вывод расстояния в Serial монитор для отладки
  Serial.println(distanceincm);     // Отправка расстояния в сантиметрах
  
  // ТРЕВОЖНАЯ ЗОНА - объект очень близко (3-90 см)
  if (distanceincm >= 3 && distanceincm <=90){
    analogWrite(ledG, 0);          // Выключить зеленый
    analogWrite(ledB, 0);          // Выключить синий
    analogWrite(ledR, 255);        // Включить красный на полную яркость (255)
    tone(Buzzer, 3000, 250);       // Включить звуковой сигнал: частота 3000 Гц, длительность 250 мс
    delay(100);                    // Пауза 100 мс
  }
  
  // ПРЕДУПРЕЖДАЮЩАЯ ЗОНА - объект на среднем расстоянии (90-170 см)
  if (distanceincm > 90 && distanceincm <=170){
    analogWrite(ledG, 255);        // Включить зеленый
    analogWrite(ledB, 0);          // Выключить синий
    analogWrite(ledR, 255);        // Включить красный (смесь красного и зеленого = желтый)
    noTone(Buzzer);                // Выключить звуковой сигнал
    delay(100);                    // Пауза 100 мс
  }
  
  // БЕЗОПАСНАЯ ЗОНА - объект далеко (170-255 см)
  if (distanceincm > 170 && distanceincm <=255){
    analogWrite(ledG, 255);        // Включить зеленый
    analogWrite(ledB, 0);          // Выключить синий
    analogWrite(ledR, 0);          // Выключить красный (только зеленый = безопасно)
    noTone(Buzzer);                // Выключить звуковой сигнал
    delay(100);                    // Пауза 100 мс
  }
  
  // При расстоянии более 255 см - все светодиоды и звук выключены
  // (не обрабатывается явно, поэтому система молчит)
}
